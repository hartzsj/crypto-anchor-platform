// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 区块链网络配置 ==========
model BlockchainNetwork {
  id          String   @id @default(uuid())
  name        String   @unique  // TRON, BSC
  displayName String   // TRON (TRC-20), BSC (BEP-20)
  chainId     String?  // 链ID (BSC: 56, TRON: 无)
  rpcUrl      String   // RPC节点地址
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tokens      Token[]
  escrowContracts EscrowContract[]
  walletAddresses WalletAddress[]
  onchainOrders   OnchainOrder[]

  @@index([name])
  @@index([isActive])
}

// ========== 支持的代币 ==========
model Token {
  id              String   @id @default(uuid())
  networkId       String
  symbol          String   // USDT, BTC, ETH
  name            String   // Tether USD, Bitcoin, Ethereum
  contractAddress String?  // 代币合约地址 (USDT需要，原生币不需要)
  decimals        Int      @default(18)
  isNative        Boolean  @default(false)  // 是否原生币 (BTC, ETH)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  network         BlockchainNetwork @relation(fields: [networkId], references: [id])
  walletBalances  WalletBalance[]

  @@unique([networkId, symbol])
  @@index([symbol])
  @@index([isActive])
}

// ========== 托管合约配置 ==========
model EscrowContract {
  id            String   @id @default(uuid())
  networkId     String
  address       String   // 合约地址
  abi           String   // JSON格式的ABI
  deployTxHash  String?  // 部署交易哈希
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  network       BlockchainNetwork @relation(fields: [networkId], references: [id])
  onchainOrders OnchainOrder[]

  @@unique([networkId, address])
  @@index([isActive])
}

// ========== 用户表 ==========
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String
  avatar        String?
  nickname      String
  role          Role     @default(USER) // USER, ADMIN
  reputation    Int      @default(100) // 信誉分，默认100
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet?
  settings      UserSettings?
  walletAddresses WalletAddress[]
  itemsPosted   Item[]
  ordersBuyer   Order[]  @relation("BuyerOrders")
  ordersSeller  Order[]  @relation("SellerOrders")
  reviewsGiven  Review[] @relation("ReviewGiver")
  reviewsReceived Review[] @relation("ReviewReceiver")
}

enum Role {
  USER
  ADMIN
}

// ========== 用户设置（通知偏好） ==========
model UserSettings {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  emailNotify   Boolean  @default(true)
  smsNotify     Boolean  @default(false)
  notifyEvents  String[] @default(["order_paid", "order_shipped", "order_completed", "deposit_received"])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ========== 钱包表 ==========
model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances      WalletBalance[]  // 多币种余额
  transactions  Transaction[]
}

// ========== 多币种余额 ==========
model WalletBalance {
  id            String   @id @default(uuid())
  walletId      String
  tokenId       String
  balance       Decimal  @default(0) @db.Decimal(18, 8)  // 可用余额
  frozenBalance Decimal  @default(0) @db.Decimal(18, 8)  // 冻结余额（托管中）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet   @relation(fields: [walletId], references: [id])
  token         Token    @relation(fields: [tokenId], references: [id])

  @@unique([walletId, tokenId])
  @@index([walletId])
}

// ========== 多链钱包地址 ==========
model WalletAddress {
  id            String   @id @default(uuid())
  userId        String
  networkId     String
  address       String   // 链上地址
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  network       BlockchainNetwork @relation(fields: [networkId], references: [id])

  @@unique([userId, networkId])
  @@index([address])
}

// ========== 交易记录表 ==========
model Transaction {
  id            String          @id @default(uuid())
  walletId      String
  tokenId       String?         // 关联的代币
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 8)
  balanceBefore Decimal         @db.Decimal(18, 8)
  balanceAfter  Decimal         @db.Decimal(18, 8)
  description   String?
  txHash        String?         // 链上交易哈希（如果是链上交易）
  orderId       String?         // 关联订单（如果是交易）
  order         Order?          @relation(fields: [orderId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([type])
  @@index([walletId])
  @@index([txHash])
}

enum TransactionType {
  DEPOSIT       // 充值
  WITHDRAW      // 提现
  ORDER_PAY     // 下单支付
  ORDER_RELEASE // 订单放款
  ORDER_REFUND  // 订单退款
}

// ========== 链上托管订单 ==========
model OnchainOrder {
  id            String   @id @default(uuid())
  orderId       String   @unique  // 平台订单ID
  networkId     String
  contractId    String
  escrowId      String   // 智能合约中的订单ID (bytes32)
  buyerAddress  String   // 买家链上地址
  sellerAddress String   // 卖家链上地址
  amount        String   // 金额 (BigInt as string)
  tokenId       String   // 代币ID
  status        OnchainOrderStatus @default(CREATED)
  fundedTxHash  String?  // 充值交易哈希
  releaseTxHash String?  // 释放交易哈希
  refundTxHash  String?  // 退款交易哈希
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  network       BlockchainNetwork @relation(fields: [networkId], references: [id])
  contract      EscrowContract    @relation(fields: [contractId], references: [id])

  @@index([orderId])
  @@index([escrowId])
  @@index([status])
}

enum OnchainOrderStatus {
  CREATED   // 已创建，等待充值
  FUNDED    // 已充值，资金托管中
  RELEASED  // 已释放给卖家
  REFUNDED  // 已退款给买家
}

// ========== 物品表 ==========
model Item {
  id            String        @id @default(uuid())
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  title         String
  description   String
  images        String[]      // 图片URL数组
  price         Decimal       @db.Decimal(18, 8) // USDT价格
  category      String        // 分类
  location      String?       // 物品所在地
  serialNumber  String?       // 序列号（可选，用于高价值物品）
  status        ItemStatus    @default(PENDING)
  approvedBy    String?       // 审核人ID
  approvedAt    DateTime?
  rejectedReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders        Order[]

  @@index([status])
  @@index([category])
  @@index([sellerId])
}

enum ItemStatus {
  PENDING     // 待审核
  APPROVED    // 已审核
  REJECTED    // 已拒绝
  SOLD        // 已售出
}

// ========== 订单表 ==========
model Order {
  id            String        @id @default(uuid())
  itemId        String
  item          Item          @relation(fields: [itemId], references: [id])
  buyerId       String
  buyer         User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId      String
  seller        User          @relation("SellerOrders", fields: [sellerId], references: [id])
  price         Decimal       @db.Decimal(18, 8) // 成交价格

  // 多链支持
  networkId     String?       // 选择的区块链网络
  tokenId       String?       // 支付代币ID
  isOnchain     Boolean       @default(false) // 是否使用链上托管

  status        OrderStatus   @default(PENDING)

  // 物流信息
  logisticsCompany String?    // 物流公司
  trackingNumber   String?    // 物流单号

  // 时间戳
  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?

  // 自动确认收货倒计时
  autoConfirmAt   DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  review          Review?
  transactions    Transaction[]

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([networkId])
  @@index([isOnchain])
}

enum OrderStatus {
  PENDING       // 待支付
  PAID          // 已支付（资金托管中）
  SHIPPED       // 已发货
  COMPLETED     // 已完成
  CANCELED      // 已取消
  DISPUTED      // 争议中
}

// ========== 评价表 ==========
model Review {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  reviewerId    String
  reviewer      User     @relation("ReviewGiver", fields: [reviewerId], references: [id])
  revieweeId    String
  reviewee      User     @relation("ReviewReceiver", fields: [revieweeId], references: [id])
  rating        Int      // 1-5星
  comment       String?
  createdAt     DateTime @default(now())

  @@index([reviewerId])
  @@index([revieweeId])
}
